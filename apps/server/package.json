{
  "name": "@bim/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "test": "vitest run"
  },
  "dependencies": { "ws": "8.18.0" },
  "devDependencies": { "@types/ws": "8.18.1", "@types/node": "22.15.21", "esbuild": "0.25.4", "tsx": "4.19.4", "vitest": "3.1.4", "@bim/sim": "0.1.0" }
}
