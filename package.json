{
  "name": "bim-grow-the-island",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bim/client",
    "dev:server": "npm run dev -w @bim/server",
    "build": "npm run build -w @bim/client && npm run build -w @bim/server",
    "start": "npm start -w @bim/server",
    "test": "npm test -w @bim/sim && npm test -w @bim/server",
    "typecheck": "tsc -p packages/sim && tsc -p apps/client && tsc -p apps/server"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
